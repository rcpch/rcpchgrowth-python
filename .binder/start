#!/bin/bash
set -euo pipefail
ts() { date +%H:%M:%S; }
echo "[start $(ts)] Kernel launch diagnostics"
python - <<'PY'
import time, importlib, sys
t0=time.time()
import rcpchgrowth
print("Imported rcpchgrowth in %.2fs" % (time.time()-t0))
