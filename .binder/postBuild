#!/bin/bash
set -euo pipefail
echo "[postBuild] Python: $(python -V)"
export PIP_DISABLE_PIP_VERSION_CHECK=1
echo "[postBuild] Upgrade build tools"
pip install --upgrade pip setuptools wheel
echo "[postBuild] Editable install"
pip install -e .
echo "[postBuild] Warm matplotlib font cache"
python - <<'PY'
import matplotlib
import matplotlib.pyplot as plt
print("Matplotlib backend:", matplotlib.get_backend())
PY
echo "[postBuild] Pre-import rcpchgrowth (light)"
python - <<'PY'
import rcpchgrowth, time
print("rcpchgrowth version:", getattr(rcpchgrowth,'__version__','?'))
PY
echo "[postBuild] Done"