#!/bin/bash

set -e  # Exit on error

JUPYTER_URL="http://localhost:8888/lab"

# Always run docker compose up -d; it's idempotent (no-op if already running)
echo "Ensuring container is running..."
docker compose up -d

# Wait for JupyterLab to respond rather than a blind sleep
echo "Waiting for JupyterLab to be ready..."
for i in $(seq 1 30); do
    if curl -s -o /dev/null -w '' "$JUPYTER_URL" 2>/dev/null; then
        break
    fi
    sleep 2
done

echo ""
echo "🎓 JupyterLab is running!"
echo "Opening: $JUPYTER_URL"
echo ""

# Try to open in browser (suppress stderr to avoid Chromium noise)
if command -v open &> /dev/null; then
    # macOS
    open "$JUPYTER_URL"
elif command -v xdg-open &> /dev/null; then
    # Linux
    xdg-open "$JUPYTER_URL" 2>/dev/null &
elif command -v wslview &> /dev/null; then
    # WSL
    wslview "$JUPYTER_URL"
else
    echo "Please open the URL manually in your browser:"
    echo "$JUPYTER_URL"
fi
